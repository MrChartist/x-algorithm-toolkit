{
  "name": "x-algorithm-mcp",
  "version": "1.0.0",
  "description": "MCP server for X (Twitter) Algorithm scoring, analysis, and tweet optimization. Uses the actual signal weights from X's open-source weighted_scorer.rs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "x-algorithm-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts"
  },
  "keywords": ["mcp", "twitter", "x-algorithm", "tweet-scorer", "content-optimization"],
  "author": "Mr_Chartist",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4"
  }
}

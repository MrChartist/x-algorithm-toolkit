{
  "name": "x-algorithm-mcp",
  "version": "2.0.0",
  "description": "MCP server for X (Twitter) Algorithm scoring, analysis, and tweet optimization. 22 engagement signals extracted from X's actual open-source weighted_scorer.rs + ranking_scorer.rs. 11 tools, 3 resources.",

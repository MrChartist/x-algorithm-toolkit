    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twitter",
    "x-algorithm",
    "tweet-scorer",
    "content-optimization",
    "engagement",
    "viral",
    "social-media",
    "ai-tools",
    "claude",
    "gemini",
    "weighted-scorer",
    "phoenix-model"
  ],
  "author": "Mr_Chartist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrChartist/x-algorithm-toolkit.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/MrChartist/x-algorithm-toolkit#readme",
  "bugs": {
    "url": "https://github.com/MrChartist/x-algorithm-toolkit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
